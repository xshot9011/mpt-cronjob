# Supply-chain hardening for every npm command run in this repo.
# Never put registry tokens in this file -- it is committed.

# Never run dependency lifecycle scripts (preinstall/install/postinstall).
# `npm start` / `npm test` / `npm run <x>` still run our own scripts.
ignore-scripts=true

# Record exact versions (no ^ranges) when adding a dependency.
save-exact=true

# Refuse to install on a Node version outside package.json "engines".
engine-strict=true

# Only ever resolve packages from the public npm registry.
registry=https://registry.npmjs.org/

fund=false
