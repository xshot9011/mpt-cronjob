{
    "chrome_driver_path": null,
    "headless": false,
    "keep_browser_open": true,
    "wait_timeout": 5,
    "action_wait": 2,
    "targets": [
        {
            "name": "Search form submission",
            "url": "https://example.com",
            "actions": [
                {
                    "type": "fill",
                    "xpath": "//input[@name='q']",
                    "value_from": "string['hello world']"
                },
                {
                    "type": "click",
                    "xpath": "//button[@type='submit']"
                },
                {
                    "type": "get",
                    "name": "first_result",
                    "xpath": "//div[@class='result'][1]//a"
                }
            ]
        }
    ]
}
