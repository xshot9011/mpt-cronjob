{
    "chrome_driver_path": null,
    "headless": true,
    "keep_browser_open": false,
    "wait_timeout": 10,
    "action_wait": 3,
    "targets": [
        {
            "name": "Click inside an iframe",
            "url": "https://example.com",
            "actions": [
                {
                    "type": "click",
                    "xpath": "//input[@type='checkbox']",
                    "iframe_title": "Widget containing a Cloudflare security challenge"
                },
                {
                    "type": "get",
                    "name": "status",
                    "xpath": "//div[@id='status']"
                }
            ]
        }
    ]
}
