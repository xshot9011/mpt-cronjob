{
    "region": "ap-southeast-7",
    "headless": true,
    "wait_timeout": 5,
    "action_wait": 2,
    "outputs": {
        "telegram": {
            "type": "telegram",
            "bot_token": "secret_manager['my-app-secrets']['TELEGRAM_BOT_TOKEN']",
            "chat_id": "secret_manager['my-app-secrets']['TELEGRAM_CHAT_ID']"
        },
        "dynamodb": {
            "type": "dynamodb",
            "table": "set-tri-history"
        }
    },
    "targets": [
        {
            "name": "SET TRI",
            "url": "https://www.set.or.th/th/market/index/tri/overview",
            "outputs": [
                "telegram",
                {
                    "name": "dynamodb",
                    "columns": {
                        "date": "as_of",
                        "SET50 TRI": "set50_tri",
                        "BANK TRI": "bank_tri",
                        "PF&REIT TRI": "pf_reit_tri"
                    }
                }
            ],
            "actions": [
                { "type": "get", "name": "date", "xpath": "//div[contains(., 'ข้อมูล ณ วันที่')]/span" },
                { "type": "get", "name": "SET50 TRI", "xpath": "//tr[td[contains(., 'SET50 TRI')]]/td[2]" },
                { "type": "click", "xpath": "//span[contains(text(), 'Expand All')]" },
                { "type": "get", "name": "BANK TRI", "xpath": "//tr[td[contains(., 'BANK TRI')]]/td[2]" },
                { "type": "get", "name": "PF&REIT TRI", "xpath": "//tr[td[contains(., 'PF&REIT TRI')]]/td[2]" },
                { "type": "get", "name": "HELTH TRI", "xpath": "//tr[td[contains(., 'HELTH TRI')]]/td[2]" }
            ]
        }
    ]
}
