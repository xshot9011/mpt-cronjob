{
    "chrome_driver_path": null,
    "headless": true,
    "keep_browser_open": false,
    "wait_timeout": 10,
    "action_wait": 2,
    "targets": [
        {
            "name": "Extract text via XPath",
            "url": "https://example.com",
            "actions": [
                {
                    "type": "get",
                    "name": "heading",
                    "xpath": "//h1"
                },
                {
                    "type": "get",
                    "name": "description",
                    "xpath": "//p[1]"
                }
            ]
        }
    ]
}
