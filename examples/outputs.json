{
    "region": "ap-southeast-7",
    "headless": true,
    "wait_timeout": 10,
    "action_wait": 2,
    "outputs": {
        "telegram": {
            "type": "telegram",
            "bot_token": "secret_manager['my-app-secrets']['TELEGRAM_BOT_TOKEN']",
            "chat_id": "secret_manager['my-app-secrets']['TELEGRAM_CHAT_ID']"
        },
        "telegram-alert": {
            "type": "telegram",
            "bot_token": "string['example_telegram_bot_token']",
            "chat_id": "string['-22222222222222']"
        }
    },
    "targets": [
        {
            "name": "Price check",
            "url": "https://example.com",
            "outputs": ["telegram"],
            "actions": [
                {
                    "type": "get",
                    "name": "current_price",
                    "xpath": "//h1"
                }
            ]
        },
        {
            "name": "Page title (log only)",
            "url": "https://example.com",
            "actions": [
                {
                    "type": "get",
                    "name": "title",
                    "script": "return document.title"
                }
            ]
        }
    ]
}
