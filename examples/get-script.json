{
    "chrome_driver_path": null,
    "headless": true,
    "keep_browser_open": false,
    "wait_timeout": 10,
    "action_wait": 2,
    "targets": [
        {
            "name": "Extract values via JavaScript",
            "url": "https://example.com",
            "actions": [
                {
                    "type": "get",
                    "name": "page_title",
                    "script": "return document.title"
                },
                {
                    "type": "get",
                    "name": "url",
                    "script": "return window.location.href"
                },
                {
                    "type": "get",
                    "name": "link_count",
                    "script": "return document.querySelectorAll('a').length.toString()"
                }
            ]
        }
    ]
}
