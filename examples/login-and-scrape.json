{
    "chrome_driver_path": null,
    "headless": true,
    "keep_browser_open": false,
    "wait_timeout": 10,
    "action_wait": 3,
    "telegram_bot_token": "secret_manager['my-app-secrets']['TELEGRAM_BOT_TOKEN']",
    "telegram_chat_id": "secret_manager['my-app-secrets']['TELEGRAM_CHAT_ID']",
    "region": "ap-southeast-1",
    "targets": [
        {
            "name": "Login then extract dashboard data",
            "url": "https://example.com/login",
            "actions": [
                {
                    "type": "fill",
                    "xpath": "//input[@id='email']",
                    "value_from": "secret_manager['my-app-secrets']['APP_USERNAME']"
                },
                {
                    "type": "fill",
                    "xpath": "//input[@id='password']",
                    "value_from": "secret_manager['my-app-secrets']['APP_PASSWORD']"
                },
                {
                    "type": "click",
                    "xpath": "//button[@type='submit']"
                },
                {
                    "type": "sleep",
                    "duration": "5s"
                },
                {
                    "type": "switch_path",
                    "path": "/dashboard"
                },
                {
                    "type": "get",
                    "name": "balance",
                    "xpath": "//span[@class='balance-value']"
                }
            ]
        }
    ]
}
