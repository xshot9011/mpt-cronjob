{
    "chrome_driver_path": null,
    "headless": true,
    "keep_browser_open": false,
    "wait_timeout": 10,
    "action_wait": 2,
    "telegram_bot_token": "string['example_telegram_bot_token']",
    "telegram_chat_id": "string['-11111111111111']",
    "targets": [
        {
            "name": "Formatted Telegram message",
            "url": "https://example.com",
            "actions": [
                {
                    "type": "get",
                    "name": "headline",
                    "xpath": "//h1",
                    "telegram_message_options": ["--no-codeblock"]
                },
                {
                    "type": "get",
                    "name": "raw_data",
                    "xpath": "//pre[@id='data']"
                }
            ]
        }
    ]
}
