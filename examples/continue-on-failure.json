{
    "chrome_driver_path": null,
    "headless": true,
    "keep_browser_open": false,
    "wait_timeout": 10,
    "action_wait": 2,
    "targets": [
        {
            "name": "Resilient scraping with continue_on_failure",
            "url": "https://example.com",
            "actions": [
                {
                    "type": "click",
                    "xpath": "//button[@id='optional-popup-close']",
                    "continue_on_failure": "true"
                },
                {
                    "type": "click",
                    "xpath": "//button[@id='cookie-dismiss']",
                    "continue_on_failure": "true"
                },
                {
                    "type": "get",
                    "name": "price",
                    "xpath": "//span[@class='price']"
                }
            ]
        }
    ]
}
