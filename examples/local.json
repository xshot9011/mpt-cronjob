{
    "chrome_driver_path": null,
    "headless": false,
    "keep_browser_open": true,
    "wait_timeout": 5,
    "action_wait": 2,
    "targets": [
        {
            "name": "Local HTML test using pure strings",
            "url": "file://./mpt-cronjob/login.html",
            "actions": [
                {
                    "type": "fill",
                    "xpath": "//input[@id='username']",
                    "value_from": "string['my_test_user']"
                },
                {
                    "type": "fill",
                    "xpath": "//input[@id='password']",
                    "value_from": "string['my_secret_password']"
                },
                {
                    "type": "click",
                    "xpath": "//button[@id='loginBtn']"
                }
            ]
        }
    ]
}
