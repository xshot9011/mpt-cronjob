{
    "chrome_driver_path": null,
    "headless": true,
    "keep_browser_open": false,
    "wait_timeout": 10,
    "action_wait": 2,
    "targets": [
        {
            "name": "Accept cookies and get page title",
            "url": "https://example.com",
            "actions": [
                {
                    "type": "click",
                    "xpath": "//button[contains(text(), 'Accept')]"
                },
                {
                    "type": "get",
                    "name": "page_title",
                    "xpath": "//h1"
                }
            ]
        }
    ]
}
