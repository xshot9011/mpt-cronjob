{
    "chrome_driver_path": null,
    "headless": true,
    "keep_browser_open": false,
    "wait_timeout": 5,
    "action_wait": 2,
    "targets": [
        {
            "name": "Navigate to subpath and extract",
            "url": "https://example.com",
            "actions": [
                {
                    "type": "get",
                    "name": "homepage_title",
                    "xpath": "//h1"
                },
                {
                    "type": "switch_path",
                    "path": "/about"
                },
                {
                    "type": "get",
                    "name": "about_title",
                    "xpath": "//h1"
                }
            ]
        }
    ]
}
