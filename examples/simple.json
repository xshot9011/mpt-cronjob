{
    "chrome_driver_path": null,
    "headless": true,
    "keep_browser_open": true,
    "wait_timeout": 10,
    "action_wait": 2,
    "targets": [
        {
            "name": "Market index overview",
            "url": "https://example.com/market/index/overview",
            "actions": [
                {
                    "type": "get",
                    "name": "date",
                    "xpath": "//div[contains(., 'Data as of')]/span"
                },
                {
                    "type": "click",
                    "xpath": "//span[contains(text(), 'Expand All')]"
                },
                {
                    "type": "get",
                    "name": "INDEX A",
                    "xpath": "//tr[td[contains(., 'INDEX A')]]/td[2]"
                },
                {
                    "type": "get",
                    "name": "INDEX B",
                    "xpath": "//tr[td[contains(., 'INDEX B')]]/td[2]"
                }
            ]
        }
    ]
}
