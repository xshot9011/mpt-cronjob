{
    "chrome_driver_path": null,
    "headless": false,
    "keep_browser_open": true,
    "wait_timeout": 5,
    "action_wait": 2,
    "telegram_bot_token": "secret_manager['<secret_manager_name>']['TELEGRAM_BOT_TOKEN']",
    "telegram_chat_id": "secret_manager['<secret_manager_name>']['TELEGRAM_CHAT_ID']",
    "region": "ap-southeast-7",
    "targets": [
        {
            "name": "Local HTML test using AWS Secrets Manager",
            "url": "file://./mpt-cronjob/login.html",
            "actions": [
                {
                    "type": "fill",
                    "xpath": "//input[@id='username']",
                    "value_from": "secret_manager['<secret_manager_name>']['USERNAME']"
                },
                {
                    "type": "fill",
                    "xpath": "//input[@id='password']",
                    "value_from": "secret_manager['<secret_manager_name>']['PASSWORD']"
                },
                {
                    "type": "click",
                    "xpath": "//button[@id='loginBtn']"
                }
            ]
        }
    ]
}
